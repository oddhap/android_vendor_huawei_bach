# Physical home button / fingerprint sensor click.
key 28    HOME          VIRTUAL
key 174   HOME          VIRTUAL

# Navigation gestures emitted by the fingerprint sensor.
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 108   DPAD_DOWN
key 103   DPAD_UP
key 111   FORWARD_DEL
